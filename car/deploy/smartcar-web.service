# Chạy backend + website NGAY TRÊN Pi (dùng khi Pi tự phát Wi-Fi, xem docs/phone.md)
# Cài:  sudo cp deploy/smartcar-web.service /etc/systemd/system/
#       sudo systemctl daemon-reload && sudo systemctl enable --now smartcar-web
[Unit]
Description=Smart Car web backend
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/VatLy_SmartCar/web/backend
Environment=MQTT_HOST=localhost
Environment=SMARTCAR_ID=car01
Environment=FRONTEND_DIR=/home/pi/VatLy_SmartCar/web/frontend/dist
ExecStart=/home/pi/VatLy_SmartCar/web/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
