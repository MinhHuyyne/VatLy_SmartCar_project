# Copy thành car/.env (trên Pi) rồi chỉnh
SMARTCAR_ID=car01
SMARTCAR_SIM=0            # 1 = giả lập trên laptop, không dùng GPIO
MQTT_HOST=192.168.1.10    # IP máy chạy Mosquitto
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
SPEED=0.5                 # tốc độ khởi động: 0.1-1.0 (= 10-100% trên website)
# Quy đổi % trên website -> duty PWM gửi cho L298N:  10% = MIN_DUTY ... 100% = MAX_DUTY
MIN_DUTY=0.3              # dưới mức này motor kêu "ù" nhưng không quay -> chỉnh theo xe thật
MAX_DUTY=0.6              # pin 3x18650 ~11V, motor TT chỉ 3-6V -> không nên vượt ~0.6
THRESHOLD_CM=25
HEARTBEAT_TIMEOUT_S=1.5
# Nếu servo rung, thử: GPIOZERO_PIN_FACTORY=pigpio (cần chạy pigpiod)

# Camera OV5647
CAMERA_ENABLED=1
CAMERA_PORT=8001
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=15
CAMERA_HFLIP=0            # lật ngang / dọc nếu gắn camera ngược
CAMERA_VFLIP=0
CAMERA_PUBLIC_URL=        # vd http://192.168.1.20:8001 nếu IP tự đoán bị sai
